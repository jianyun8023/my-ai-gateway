# Docker Compose deployment environment.
# Copy this file to .env.compose, replace every placeholder, and keep the copy
# out of Git. Run Compose with: docker compose --env-file .env.compose ...

# ── Published Gateway endpoint ────────────────────────────
# Bind to loopback by default and put TLS/reverse proxy in front when needed.
GATEWAY_IMAGE=my-ai-gateway:local
GATEWAY_BIND_ADDRESS=127.0.0.1
GATEWAY_PORT=8787

# ── PostgreSQL ─────────────────────────────────────────────
# POSTGRES_PASSWORD is inserted into DATABASE_URL. Use URL-safe characters
# (for example, an openssl-generated hex value) or provide a compatible value.
POSTGRES_USER=gateway
POSTGRES_PASSWORD=replace-with-a-url-safe-database-password
POSTGRES_DB=gateway

# ── Gateway access and bootstrap ───────────────────────────
GATEWAY_API_KEY=
GATEWAY_ADMIN_KEY=replace-with-a-different-admin-secret
GATEWAY_CONFIG_JSON=
GATEWAY_CONFIG_IMPORT=false
GATEWAY_SOURCE_URL_ALLOWLIST=

# Required credential and recoverable Virtual Key envelope encryption.
GATEWAY_CREDENTIAL_MASTER_KEY=replace-with-a-stable-random-master-secret
GATEWAY_CREDENTIAL_MASTER_KEYS=
GATEWAY_CREDENTIAL_MASTER_KEY_VERSION=v1
GATEWAY_CREDENTIAL_ACTIVE_KEY_VERSION=

# ── Runtime tuning ─────────────────────────────────────────
GATEWAY_HEALTH_COOLDOWN_MS=30000
GATEWAY_HEALTH_MAX_COOLDOWN_MS=1800000
GATEWAY_HEALTH_STALE_AFTER_SECS=600
GATEWAY_HEALTH_PROBE_INTERVAL_SECS=60
GATEWAY_HEALTH_PROBE_ENABLED=true
GATEWAY_HEALTH_PROBE_ON_STARTUP=false
GATEWAY_SSE_HEARTBEAT_INTERVAL_MS=15000
# Wait up to 120 seconds for upstream response headers (JSON and SSE).
GATEWAY_SSE_CONNECTION_TIMEOUT_MS=120000
GATEWAY_SSE_FIRST_EVENT_TIMEOUT_MS=30000
GATEWAY_SSE_IDLE_TIMEOUT_MS=60000
GATEWAY_SSE_TOTAL_TIMEOUT_MS=300000

# Optional OpenTelemetry export.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# OTEL_SERVICE_NAME=my-ai-gateway

# ── Upstream Provider credentials ──────────────────────────
# Names must match Account.credential_env in the imported control-plane config.
KIMI_API_KEY=
MINIMAX_API_KEY=
MINIMAX_API_KEY_2=
DEEPSEEK_API_KEY=
SILICONFLOW_API_KEY=
B_AI_API_KEY=
