# Explicit opt-in. The live runner refuses to start unless this is exactly 1.
LIVE_PROVIDER_TESTS=

# Dedicated PostgreSQL database. The runner creates and drops an isolated schema.
LIVE_TEST_DATABASE_URL=postgres://gateway:gateway@127.0.0.1:5432/gateway_test

# Provider credentials and controlled upstream URLs.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io
KIMI_API_KEY=
KIMI_BASE_URL=https://api.kimi.com/coding
B_AI_API_KEY=
B_AI_BASE_URL=https://api.b.ai/v1

# Per-request timeout for server-side search and reasoning cases.
LIVE_REQUEST_TIMEOUT_MS=300000
