# my-ai-gateway 环境变量示例
# 复制为 .env 并按需填写；.env / .env.* 已被 .gitignore 忽略，请勿提交真实密钥。

# ── 网关服务 ──────────────────────────────────────────────
# 下游监听地址（默认 127.0.0.1:8787）
GATEWAY_LISTEN_ADDR=127.0.0.1:8787

# 下游静态入口 Key（临时方案，后续由 PostgreSQL Virtual Key 替代）。
# 设置后客户端携带该 Key 即放行；未设置时走数据库 Virtual Key 认证；
# 两者都没有则完全无认证，仅限本地调试。
GATEWAY_API_KEY=

# Admin API（/admin/*）专用鉴权 Key，不会回退为 GATEWAY_API_KEY。
# 未设置时网关仍可启动，但所有 Admin API 请求固定返回 401。
GATEWAY_ADMIN_KEY=

# PostgreSQL 控制面连接串。DB-first 运行时必填；启动时自动执行 migrations/，
# 并从一致性事务构建不可变路由 snapshot。
DATABASE_URL=postgres://gateway:gateway@127.0.0.1:5432/gateway

# 开发/测试期一次性初始化：完整 Provider/Account/Route JSON（结构见 config.example.json）。
# 仅控制面为空时读取；已有管理数据时不会解析或覆盖。运行期事实来源为 PostgreSQL。
# 单行 JSON 示例：GATEWAY_CONFIG_JSON='{"providers":[...],"accounts":[...],"routes":[...]}'
GATEWAY_CONFIG_JSON=

# 显式设为 true 时，以 GATEWAY_CONFIG_JSON 事务化替换现有开发控制面。
# 该操作会删除并重建 Source/Account/LogicalModel/Binding/Route，默认必须为 false。
GATEWAY_CONFIG_IMPORT=false

# ── 账号健康与主动探测 ───────────────────────────────────
# 被动失败/探测失败的初始冷却（毫秒）与指数退避上限（毫秒）。
GATEWAY_HEALTH_COOLDOWN_MS=30000
GATEWAY_HEALTH_MAX_COOLDOWN_MS=1800000
# 超过该时间没有健康观测时标记 stale；stale 只是不确定性提示，不会永久屏蔽账号。
GATEWAY_HEALTH_STALE_AFTER_SECS=600
# 周期主动探测间隔（秒）。探测复用 ProviderPreset 连接测试。
GATEWAY_HEALTH_PROBE_INTERVAL_SECS=60
# 默认开启周期探测；启动时立即探测需显式开启。
GATEWAY_HEALTH_PROBE_ENABLED=true
GATEWAY_HEALTH_PROBE_ON_STARTUP=false

# 可选的本机环境覆盖文件；`mise run dev` 会在 .env 之后加载它。
# 适合将真实 Provider Key 放在被 Git 忽略且权限为 600 的文件中。
GATEWAY_ENV_FILE=

# ── SSE 流式契约（进程级配置，0 表示禁用该限制）──────────────
# 心跳是 SSE comment，不会进入 Provider 事件、Usage 或序列号。
GATEWAY_SSE_HEARTBEAT_INTERVAL_MS=15000
# 连接时限覆盖等待响应头；首事件/空闲/总时限覆盖已建立的 SSE。
GATEWAY_SSE_CONNECTION_TIMEOUT_MS=10000
GATEWAY_SSE_FIRST_EVENT_TIMEOUT_MS=30000
GATEWAY_SSE_IDLE_TIMEOUT_MS=60000
GATEWAY_SSE_TOTAL_TIMEOUT_MS=300000

# 独立运行 kimi-responses-adapter 时使用 KIMI_SSE_* 对应变量；
# 嵌入网关时由上面的 GATEWAY_SSE_* 统一传入。
KIMI_SSE_HEARTBEAT_INTERVAL_MS=15000
KIMI_SSE_CONNECTION_TIMEOUT_MS=10000
KIMI_SSE_FIRST_EVENT_TIMEOUT_MS=30000
KIMI_SSE_IDLE_TIMEOUT_MS=60000
KIMI_SSE_TOTAL_TIMEOUT_MS=300000

# ── OpenTelemetry tracing ─────────────────────────────────
# 设置 OTLP endpoint 后自动启用 OTel tracing 导出（gRPC）。
# 未设置时只使用 fmt 日志，不会尝试连接 collector。
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_SERVICE_NAME=my-ai-gateway

# ── 前端开发服务器 ────────────────────────────────────────
# Vite 默认仅监听本机；局域网联调时改为 0.0.0.0。
VITE_DEV_HOST=127.0.0.1

# `mise run dev` 中 Vite 代理到本机 Rust 网关的地址。
VITE_API_PROXY_TARGET=http://127.0.0.1:8787

# ── 上游 Provider 凭据 ────────────────────────────────────
# 变量名由配置中 Account 的 credential_env 指定，以下为 config.example.json 使用的名字。
KIMI_API_KEY=
MINIMAX_API_KEY=
MINIMAX_API_KEY_2=
DEEPSEEK_API_KEY=
# 自定义渠道（OpenAI 兼容）示例，如硅基流动：
SILICONFLOW_API_KEY=
# b.ai（https://api.b.ai/v1，免费 deepseek-v4-flash / glm-5.3-flash 等）：
B_AI_API_KEY=

# PostgreSQL 回归测试使用独立的 .env.test，见 .env.test.example。
