# my-ai-gateway 环境变量示例
# 复制为 .env 并按需填写；.env / .env.* 已被 .gitignore 忽略，请勿提交真实密钥。

# ── 网关服务 ──────────────────────────────────────────────
# 下游监听地址（默认 127.0.0.1:8787）
GATEWAY_LISTEN_ADDR=127.0.0.1:8787

# 下游静态入口 Key（临时方案，后续由 PostgreSQL Virtual Key 替代）。
# 设置后客户端携带该 Key 即放行；未设置时走数据库 Virtual Key 认证；
# 两者都没有则完全无认证，仅限本地调试。
GATEWAY_API_KEY=

# Admin API（/admin/*）专用鉴权 Key，不会回退为 GATEWAY_API_KEY。
# 未设置时网关仍可启动，但所有 Admin API 请求固定返回 401。
GATEWAY_ADMIN_KEY=

# PostgreSQL 控制面连接串。DB-first 运行时必填；启动时自动执行 migrations/，
# 并从一致性事务构建不可变路由 snapshot。
DATABASE_URL=postgres://gateway:gateway@127.0.0.1:5432/gateway

# 开发/测试期一次性初始化：完整 Provider/Account/Route JSON（结构见 config.example.json）。
# 仅控制面为空时读取；已有管理数据时不会解析或覆盖。运行期事实来源为 PostgreSQL。
# 单行 JSON 示例：GATEWAY_CONFIG_JSON='{"providers":[...],"accounts":[...],"routes":[...]}'
GATEWAY_CONFIG_JSON=

# 显式设为 true 时，以 GATEWAY_CONFIG_JSON 事务化替换现有开发控制面。
# 该操作会删除并重建 Source/Account/LogicalModel/Binding/Route，默认必须为 false。
GATEWAY_CONFIG_IMPORT=false

# ── 上游 Provider 凭据 ────────────────────────────────────
# 变量名由配置中 Account 的 credential_env 指定，以下为 config.example.json 使用的名字。
KIMI_API_KEY=
MINIMAX_API_KEY=
MINIMAX_API_KEY_2=
DEEPSEEK_API_KEY=
# 自定义渠道（OpenAI 兼容）示例，如硅基流动：
SILICONFLOW_API_KEY=
# b.ai（https://api.b.ai/v1，免费 deepseek-v4-flash / glm-5.3-flash 等）：
B_AI_API_KEY=

# ── 测试 ──────────────────────────────────────────────────
# 需要真实 PostgreSQL 的测试用。完整控制面 ignored test 必须显式设置并实际运行；
# 测试会在该数据库内创建并清理独立 schema。
TEST_DATABASE_URL=
