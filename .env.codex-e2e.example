# Explicit opt-in. This runner makes real Codex CLI and Provider requests.
CODEX_E2E_TESTS=1

# Gateway Responses endpoint and Admin credential used to reveal a recoverable
# PostgreSQL Virtual Key. Selectors are optional; the first active recoverable
# key is used when both are empty.
CODEX_GATEWAY_BASE_URL=http://127.0.0.1:8788/v1
CODEX_GATEWAY_ADMIN_KEY=
CODEX_VIRTUAL_KEY_ID=
CODEX_VIRTUAL_KEY_NAME=

# Optional explicit override for legacy/non-DB environments.
CODEX_GATEWAY_API_KEY=

# Must be present in the target Gateway's current GET /v1/models response.
# Examples depend on the active control-plane snapshot.
CODEX_MODEL=k3
CODEX_CLI=codex
CODEX_E2E_TIMEOUT_MS=300000

# These paths are ignored and must not be the user's normal ~/.codex.
CODEX_HOME=target/codex-e2e/home
CODEX_E2E_WORKSPACE=target/codex-e2e/workspace
CODEX_E2E_RESULT_DIR=target/codex-e2e/results
