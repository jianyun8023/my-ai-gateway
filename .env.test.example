# PostgreSQL 回归测试专用连接串，不得指向运行时 DATABASE_URL 使用的数据库。
# `mise run test-db` 会加载本文件复制出的 .env.test，并串行运行含 ignored 用例的回归。
TEST_DATABASE_URL=postgres://gateway:gateway@127.0.0.1:5432/gateway_test

# 健康回归测试可按需缩短时间；测试本身使用注入时钟，不依赖真实 sleep。
GATEWAY_HEALTH_COOLDOWN_MS=30000
GATEWAY_HEALTH_MAX_COOLDOWN_MS=1800000
GATEWAY_HEALTH_STALE_AFTER_SECS=600
GATEWAY_HEALTH_PROBE_INTERVAL_SECS=60
GATEWAY_HEALTH_PROBE_ENABLED=false
GATEWAY_HEALTH_PROBE_ON_STARTUP=false
