{
  "_comment": "仅用于空控制面初始化或 GATEWAY_CONFIG_IMPORT=true 显式导入；运行时配置以 PostgreSQL snapshot 为准",
  "listen_addr": "0.0.0.0:8787",
  "providers": [
    {
      "id": "minimax",
      "name": "MiniMax",
      "base_url": "https://your-minimax-endpoint",
      "models": ["MiniMax-M2.7"],
      "native_protocols": ["openai_chat_completions", "openai_responses", "anthropic_messages"],
      "endpoints": {
        "openai_chat_completions": "/v1/chat/completions",
        "openai_responses": "/v1/responses",
        "anthropic_messages": "/anthropic/v1/messages"
      },
      "capabilities": {"streaming": "native", "tools": "native", "thinking": "native", "web_search": "native", "usage": "native"},
      "protocol_capabilities": {
        "openai_chat_completions": {"mode": "native"},
        "openai_responses": {"mode": "native"},
        "anthropic_messages": {"mode": "native"}
      },
      "model_overrides": {}
    },
    {
      "id": "deepseek",
      "name": "DeepSeek",
      "base_url": "https://your-deepseek-endpoint",
      "models": ["deepseek-chat", "deepseek-reasoner"],
      "native_protocols": ["openai_chat_completions", "openai_responses", "anthropic_messages"],
      "endpoints": {
        "openai_chat_completions": "/v1/chat/completions",
        "openai_responses": "/v1/responses",
        "anthropic_messages": "/anthropic/v1/messages"
      },
      "capabilities": {"streaming": "native", "tools": "native", "thinking": "native", "web_search": "native", "usage": "native"},
      "protocol_capabilities": {
        "openai_chat_completions": {"mode": "native"},
        "openai_responses": {"mode": "native"},
        "anthropic_messages": {"mode": "native"}
      },
      "model_overrides": {}
    },
    {
      "id": "kimi_code",
      "name": "Kimi Code CN",
      "base_url": "https://api.kimi.com/coding",
      "models": ["kimi-for-coding-highspeed"],
      "native_protocols": ["openai_chat_completions", "openai_responses", "anthropic_messages"],
      "endpoints": {
        "openai_chat_completions": "/v1/chat/completions",
        "openai_responses": "/v1/responses",
        "anthropic_messages": "/v1/messages"
      },
      "capabilities": {"streaming": "native", "tools": "native", "thinking": "native", "web_search": "native", "usage": "native"},
      "protocol_capabilities": {
        "openai_chat_completions": {"mode": "native"},
        "openai_responses": {"mode": "native"},
        "anthropic_messages": {"mode": "native"}
      },
      "model_overrides": {}
    }
  ],
  "accounts": [
    {"id": "minimax-main", "provider_id": "minimax", "display_name": "MiniMax 主账号", "credential_env": "MINIMAX_API_KEY", "enabled": true, "weight": 100},
    {"id": "minimax-backup", "provider_id": "minimax", "display_name": "MiniMax 备用账号", "credential_env": "MINIMAX_API_KEY_2", "enabled": true, "weight": 50},
    {"id": "deepseek-main", "provider_id": "deepseek", "display_name": "DeepSeek 主账号", "credential_env": "DEEPSEEK_API_KEY", "enabled": true, "weight": 100,
      "model_map": {"MiniMax-M2.7": "deepseek-chat"}},
    {"id": "kimi-main", "provider_id": "kimi_code", "display_name": "Kimi Code CN", "credential_env": "KIMI_API_KEY", "enabled": true, "weight": 100,
      "model_overrides": {"kimi-for-coding-highspeed": {"capabilities": {"web_search": "native", "thinking": "native"}}}}
  ],
  "routes": [
    {
      "id": "minimax-all-native",
      "model": "MiniMax-M2.7",
      "provider_id": "minimax",
      "protocols": ["openai_chat_completions", "openai_responses", "anthropic_messages"],
      "primary_account_id": "minimax-main",
      "fallback_accounts": ["minimax-backup", "deepseek-main"],
      "mode": "native"
    },
    {
      "id": "deepseek-all-native",
      "model": "deepseek-*",
      "provider_id": "deepseek",
      "protocols": ["openai_chat_completions", "openai_responses", "anthropic_messages"],
      "primary_account_id": "deepseek-main",
      "mode": "native"
    },
    {
      "id": "kimi-native",
      "model": "kimi-for-coding-highspeed",
      "provider_id": "kimi_code",
      "protocols": ["openai_chat_completions", "openai_responses", "anthropic_messages"],
      "primary_account_id": "kimi-main",
      "mode": "native"
    }
  ]
